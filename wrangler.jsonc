{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minigame",
  "main": "worker.js",
  "compatibility_date": "2026-06-05",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE",
        "class_name": "ArcadeStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ArcadeStore"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "MAIL_FROM": "1517762555@qq.com",
    "MAIL_TO": "1517762555@qq.com"
  }
}
