{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minigame",
  "main": "worker.js",
  "compatibility_date": "2026-06-05",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "DATA",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}